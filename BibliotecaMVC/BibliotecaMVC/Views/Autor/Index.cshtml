
@model IEnumerable<BibliotecaMVC.Models.Autor>
@{
    ViewData["Title"] = "Autor";
}

<h2>Catalogo de Autores</h2>
<a asp-action="Create" class="btn btn-primary">Nuevo autor</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Nacionalidad</th>
            <th>Fecha de nacimiento</th>
            <th>Activo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach( var autor in Model)
        {
            <tr>
                <td>@autor.ID</td>
                <td>@autor.Nombre</td>
                <td>@autor.Apellido</td>
                <td>@autor.Nacionalidad</td>
                <td>@autor.FechaNacimiento</td>
                <td>
                    @if (@autor.Activo)
                    {
                        <spam class="badge bg-success">Activo</spam>
                    }
                    else
                    {
                        <spam class="badge bg-danger">Inactivo</spam>
                    }
                </td>
                <td><a asp-action="Details" asp-route-id="@autor.ID" class="btn btn-primary">Detalles</a></td>
                <td><a asp-action="Edit" asp-route-id="@autor.ID" class="btn btn-warning">Editar</a></td>
                <td><a asp-action="Delete" asp-route-id="@autor.ID" class="btn btn-danger">Eliminar</a></td>
            </tr>
        }
    </tbody>
</table>