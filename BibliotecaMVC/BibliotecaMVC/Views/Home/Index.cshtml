@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-4">
    <div class="p-4 mb-4 bg-light rounded">
        <h1 class="display-5">Biblioteca MVC</h1>
        <p class="lead">Explora autores, Libros, categorias, gestiona tus prestamos todo en un mismo sitio </p>
        <a class="btn btn-primary" asp-controller="home" asp-action="about">Conocer más</a>
        <a class="btn btn-secondary" asp-controller="libros" asp-action="Index">Libros</a>
    </div>

    <div id="carouselBiblioteca" class="carousel slide mb-4" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselBiblioteca" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselBiblioteca" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselBiblioteca" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>



        <div class="carousel-inner rounded">
            <div class="carousel-item active">
                <img src="~/images/carousel-1.jpg" class="d-block w-100" alt="Estanteria de libros en la biblioteca"/>
                <div class="carousel-caption d-none d-md-block">
                    <h5>Catalogo digital</h5>
                    <p>Descubre nuevos titulos en nuestro catalogo</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/carousel-2.jpg" class="d-block w-100" alt="Espacio de lectura" />
                <div class="carousel-caption d-none d-md-block">
                    <h5>Autores y Obras</h5>
                    <p>Explora autores y encuentra tu proxima lectura</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/carousel-3.jpg" class="d-block w-100" alt="Libros y servicios" />
                <div class="carousel-caption d-none d-md-block">
                    <h5>Libros y Servicios</h5>
                    <p>Prestamos, Servicios, Horarios y consultas todo en un mismo sitio</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselBiblioteca" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselBiblioteca" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>

        

    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Catalogo de libros</h5>
                    <p class="card-text">
                        Encuentra libros por nombre, disponibilidad y datos de publicación.
                        ideal para buscar lecturas y gestionar el inventario
                    </p>
                    <a class="btn btn-primary" asp-controller="libros" asp-action="Index">Explorar Libros</a>
                </div>
            </div>
        </div>


        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Autores</h5>
                    <p class="card-text">Conoce a los autores y sus obras asociadas</p>
                    <a class="btn btn-primary" asp-controller="Autor" asp-action="Index">Ver autores</a>
                </div>
            </div>
        </div>


        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Categorias</h5>
                    <p class="card-text">Busca por género o temática para llegar más rápido al libro indicado</p>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Categorias">Ver Categorias</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header">Servicios bibliotecarios</div>
                <div class="card-body">
                    <p class="card-text">Además del catalogo de Libros, La biblioteca ofrece:</p>
                    <ul>
                        <li>Prestamo y devolución de ejemplares</li>
                        <li>Orientación para localizar libros dentro del catalogo</li>
                        <li>Consulta de información de usuarios</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>
