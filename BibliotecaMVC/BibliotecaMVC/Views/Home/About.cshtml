@{
    ViewData["Title"] = "Acerca de";
}

<article class="about-page">

    <header class="about-header">
        <h1>Acerca de la Biblioteca Virtual</h1>
        <p>
            Espacio digital para consultar libros, autores, categorías
            y servicios.
        </p>
    </header>

    <section class="about-container">
        <article class="about-content">
            <h2>¿Qué es esta aplicación?</h2>
            <p>
                BibliotecaMVC es un sistema web desarrollado con ASP.NET Core MVC
                para la asignatura de Programación Web 2 Frontend. Permite organizar y consultar
                información de una biblioteca de forma sencilla.
            </p>
            <p>
                Desde este portal puedes explorar el catálogo, conocer autores
                y entender cómo se relacionan categorías y servicios de préstamo.
            </p>
        </article>

        <aside class="about-info">
            <h3>Propósito</h3>
            <p>
                Aplicar HTML5, CSS3 y diseño responsivo en un proyecto real
                con arquitectura MVC.
            </p>
            <h3>Servicios</h3>
            <ul>
                <li>Consulta de libros</li>
                <li>Información de autores</li>
                <li>Orientación por categorías</li>
            </ul>
        </aside>
    </section>

    <!--COMPONENTES REUTILIZABLES-->
    <section class="about-services">
        <h2>Servicios de la Biblioteca utilizando componentes reutilizables</h2>
        <div class="container-service-card">
            @await Html.PartialAsync(
            "_ServiceCard",
            new BibliotecaMVC.Models.ServiceCard{
                ImageUrl = "/images/carousel-1.jpg",
                Text = "Préstamo y devolución de libros en la biblioteca."
            })
            @await Html.PartialAsync(
            "_ServiceCard",
            new BibliotecaMVC.Models.ServiceCard
            {
                ImageUrl = "https://picsum.photos/id/24/400/200",
                Text = "Consulta y catalogo por titulo y disponibilidad."
            })
            @await Html.PartialAsync(
            "_ServiceCard",
            new BibliotecaMVC.Models.ServiceCard
            {
                ImageUrl = "https://picsum.photos/id/24/400/200",
                Text = "Orientación para localizar libros por categoria."
            })
        </div>
    </section>

    <section class="about-services">
        <h2>Caracteristicas del sistema (componentes reutilizables)</h2>
        <div class="container-info-card">
            @await Html.PartialAsync(
                "_InfoCard",
                new BibliotecaMVC.Models.InfoCard{
                    Title = "Libros",
                    Description = "Gestiona titulos, disponibilidad y todo el catalogo de Libros"
                }
            )
            @await Html.PartialAsync(
                "_InfoCard",
                new BibliotecaMVC.Models.InfoCard
                {
                    Title = "Autores",
                    Description = "Consulte quien escribio cada obra y explora sus publicaciones"
                }
            )
            @await Html.PartialAsync(
                "_InfoCard",
                new BibliotecaMVC.Models.InfoCard
                {
                    Title = "Categorias",
                    Description = "Clasifica la colección por género o tema para buscar más rápido"
                }
            )

        </div>
    </section>

    <!--COMPONENTES REUTILIZABLES-->

    <section class="team-section">
        <figure>
            <img src="~/images/carousel-2.jpg" alt="Sala de lectura de una biblioteca" />
            <figcaption>
                Biblioteca virtual desarrollada con ASP.NET Core MVC
            </figcaption>
        </figure>
    </section>

</article>