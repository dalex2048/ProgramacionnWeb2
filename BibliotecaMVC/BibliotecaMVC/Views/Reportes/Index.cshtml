@model BibliotecaMVC.Models.ReporteLibrosViewModel
@{
    ViewData["Title"] = "Reportes de Libros";
}

<h2>Reportes de Libros</h2>
<p class="text-muted">
    Consulta, filtra y exporta la información de los libros registrados en la base de datos de BibliotecaMVC.
</p>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="autor" class="form-label">Autor</label>
            <select id="autor" name="autor" class="form-select">
                <option value="">-- Todos los autores --</option>
                @foreach (var autor in Model.OpcionesAutor)
                {
                    <option value="@autor" selected="@(autor == Model.FiltroAutor)">@autor</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label for="categoria" class="form-label">Categoría</label>
            <select id="categoria" name="categoria" class="form-select">
                <option value="">-- Todas las categorías --</option>
                @foreach (var categoria in Model.OpcionesCategoria)
                {
                    <option value="@categoria" selected="@(categoria == Model.FiltroCategoria)">@categoria</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Aplicar filtros</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>

    <hr />

    
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" asp-action="GenerarPdf" class="btn btn-danger">Generar reporte PDF</button>
        <button type="submit" asp-action="ExportarExcel" class="btn btn-success">Exportar a Excel</button>
    </div>
</form>


<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <div class="small">Total de libros</div>
                <div class="fs-3 fw-bold">@Model.TotalLibros</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <div class="small">Disponibles</div>
                <div class="fs-3 fw-bold">@Model.TotalDisponibles</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-bg-danger h-100">
            <div class="card-body">
                <div class="small">Prestados</div>
                <div class="fs-3 fw-bold">@Model.TotalPrestados</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-bg-dark h-100">
            <div class="card-body">
                <div class="small">Valor total</div>
                <div class="fs-3 fw-bold">$@Model.ValorTotal.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<p class="text-muted">Filtros aplicados: <strong>@Model.DescripcionFiltros</strong></p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre del libro</th>
                <th>Autor</th>
                <th>Categoría</th>
                <th class="text-end">Precio</th>
                <th class="text-center">Disponibilidad</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TotalLibros == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No hay libros que cumplan los filtros.</td>
                </tr>
            }
            @foreach (var libro in Model.Libros)
            {
                <tr>
                    <td>@libro.ID</td>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td>@libro.Categoria</td>
                    <td class="text-end">$@libro.Precio.ToString("N2")</td>
                    <td class="text-center">
                        @if (libro.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Prestado</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>