}
<h2>Catalogo de Libros</h2>

<a asp-action="Create" class="btn btn-primary">Nuevo Libro</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titulo</th>
            <th>Autor</th>
            <th>Categoria</th>
            <th>Precio</th>
            <th>Disponibilidad</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.ID</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td>@libro.Categoria</td>
                <td>$@libro.Precio</td>
                <td>
                    @if (@libro.Disponible)
                    {
                        <spam class="badge bg-success">Disponible</spam>
                    }
                    else
                    {
                        <spam class="badge bg-danger">Prestado</spam>
                    }
                </td>
                <td><a asp-action="Details" asp-route-id ="@libro.ID" class="btn btn-primary">Detalles</a></td>
                <td><a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-warning">Editar</a></td>
                <td><a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-danger">Eliminar</a></td>


            </tr>
        }
    </tbody>

</table>



